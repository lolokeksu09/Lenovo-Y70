<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/card_dark">

        <Button
            android:id="@+id/btn_back_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:gravity="center"
            android:background="@drawable/btn_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="← Меню"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Отключение APK"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_debloat_rollback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:gravity="center"
            android:background="@drawable/btn_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="🔄 Откат"
            android:textAllCaps="false"
            android:textColor="@color/accent_yellow"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#141820"
        android:padding="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_tab_preset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:text="Сценарий"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_tab_manual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Все приложения (Ручной)"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- TAB 1: PRESET TAB -->
    <ScrollView
        android:id="@+id/scroll_preset_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <!-- 4 Debloat Presets Horizontal Bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_preset_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:gravity="center"
                        android:background="@drawable/btn_primary"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Авторский (111)"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_preset_aosp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:gravity="center"
                        android:background="@drawable/btn_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Чистый"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_preset_balanced"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:gravity="center"
                        android:background="@drawable/btn_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Баланс"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_preset_minimal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:gravity="center"
                        android:background="@drawable/btn_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Минимальный"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Preset Info & Actions Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ПАКЕТНЫЙ СЦЕНАРИЙ ОЧИСТКИ"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_preset_info_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Авторский (Y70 Edition)"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <!-- Structured Preset Table Info Block -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#151921"
                    android:padding="12dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tv_preset_target"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 Для кого: Проверенный вами лично"
                        android:textColor="@color/accent_blue"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_preset_what_inside"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Что внутри: Ваш эталонный список из 111 пакетов..."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_show_preset_table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_chip"
                    android:text="📋 Сравнительная таблица всех 4 сценариев"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_preset_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отключено: ... / ..."
                    android:textColor="@color/accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <ProgressBar
                    android:id="@+id/pb_preset_batch"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <Button
                        android:id="@+id/btn_preset_apply_all"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_red"
                        android:text="🚫 Применить пресет"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_preset_enable_all"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_green"
                        android:text="🔄 Откат пресета"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_full_stock_rollback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="38dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_chip"
                    android:text="Восстановить изменения Lenovo Y70"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Пакеты с защитой прошивки Moto (PAKS, Device Management) без Root изолируются через AppOps: блокируется фоновый запуск, wakelock и уведомления."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СПИСОК ПАКЕТОВ В СЦЕНАРИИ:"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/ll_preset_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- TAB 2: MANUAL APPS TAB -->
    <LinearLayout
        android:id="@+id/layout_manual_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:visibility="gone">

        <!-- Search Bar -->
        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/input_search_bg"
            android:hint="🔍 Поиск по названию или пакету..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true" />

        <!-- Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:background="@drawable/btn_primary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Все"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_filter_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:background="@drawable/btn_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Системные"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_filter_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:background="@drawable/btn_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Сторонние"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_filter_disabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:background="@drawable/btn_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Отключенные"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Actions for manual package management; preserves active search/filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_refresh_apps"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:background="@drawable/btn_chip"
                android:text="Обновить"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_enable_all_disabled"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:background="@drawable/btn_green"
                android:text="Включить все отключённые"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_disabled_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Проверка состояния приложений…"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pb_bulk_enable"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_bulk_enable_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/pb_loading_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:visibility="gone" />

        <!-- Apps List -->
        <ListView
            android:id="@+id/lv_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:divider="@null"
            android:dividerHeight="0dp" />

    </LinearLayout>

</LinearLayout>
